{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jidan.dev/jcl.hand-provider-v0.1.schema.json",
  "title": "JCL Hand Provider 0.1",
  "description": "Host-trusted registration for a replaceable Android execution backend. A provider manifest describes a hand; it does not grant that hand permission to execute.",
  "type": "object",
  "properties": {
    "profile": {
      "const": "JCL-Hand-Provider/0.1"
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "providerKind": {
      "enum": [
        "OWNED",
        "VENDOR",
        "CANDIDATE"
      ]
    },
    "trustState": {
      "enum": [
        "OWNED_RUNTIME_LOCAL_VERIFIED",
        "OWNED_ADAPTER_STUB",
        "VENDOR_CONTRACT_VERIFIED",
        "CANDIDATE_UNBOUND"
      ]
    },
    "transport": {
      "enum": [
        "LOCAL_ACCESSIBILITY",
        "MCP_LOCAL",
        "MCP_REMOTE",
        "HANDOFF_ONLY"
      ]
    },
    "targetPackage": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "declaredPlanProfile": {
      "enum": [
        "JCL-UI-Action-Plan/0.1",
        "JCL-Owned-Action-Plan/0.1"
      ]
    },
    "supportedLanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SANDBOX",
          "OWNED_APP",
          "SHADOW",
          "HANDOFF"
        ]
      }
    },
    "observedCapabilities": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SEMANTIC_TREE",
          "NODE_ACTIONS",
          "GESTURES",
          "TEXT_INPUT",
          "SCREENSHOT",
          "OCR",
          "SCRIPT_ENGINE",
          "APP_LAUNCH"
        ]
      }
    },
    "executionEnabled": {
      "type": "boolean"
    },
    "publicContract": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "protocol": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "definitionSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "available",
        "protocol",
        "definitionSha256"
      ],
      "additionalProperties": false
    },
    "hostAdapter": {
      "description": "A Host-owned local mapping. This is not a public MCP endpoint and cannot be selected by an untrusted caller.",
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "profileSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "available",
        "profileSha256"
      ],
      "additionalProperties": false
    },
    "identityBinding": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "RUNTIME_SIGNER_AND_CONTRACT",
            "STATIC_ARTIFACT"
          ]
        },
        "versionCode": {
          "type": "integer",
          "minimum": 1
        },
        "certificateSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifactSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "contractId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        }
      },
      "required": [
        "mode",
        "versionCode",
        "certificateSha256",
        "artifactSha256",
        "contractId"
      ],
      "additionalProperties": false
    },
    "realWorldEffectCeiling": {
      "enum": [
        "SYNTHETIC_ONLY",
        "OWNED_LOCAL_APP",
        "HANDOFF_ONLY",
        "PROVIDER_DECLARED"
      ]
    },
    "notes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    }
  },
  "required": [
    "profile",
    "providerId",
    "displayName",
    "providerKind",
    "trustState",
    "transport",
    "targetPackage",
    "declaredPlanProfile",
    "supportedLanes",
    "observedCapabilities",
    "executionEnabled",
    "publicContract",
    "hostAdapter",
    "identityBinding",
    "realWorldEffectCeiling",
    "notes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "trustState": {
            "const": "OWNED_ADAPTER_STUB"
          }
        },
        "required": [
          "trustState"
        ]
      },
      "then": {
        "properties": {
          "providerKind": {
            "const": "OWNED"
          },
          "executionEnabled": {
            "const": false
          },
          "observedCapabilities": {
            "const": []
          },
          "publicContract": {
            "properties": {
              "available": { "const": false },
              "protocol": { "const": null },
              "definitionSha256": { "const": null }
            }
          },
          "hostAdapter": {
            "properties": {
              "available": { "const": false },
              "profileSha256": { "const": null }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "trustState": {
            "const": "CANDIDATE_UNBOUND"
          }
        },
        "required": [
          "trustState"
        ]
      },
      "then": {
        "properties": {
          "providerKind": {
            "const": "CANDIDATE"
          },
          "transport": {
            "const": "HANDOFF_ONLY"
          },
          "executionEnabled": {
            "const": false
          },
          "realWorldEffectCeiling": {
            "const": "HANDOFF_ONLY"
          },
          "supportedLanes": {
            "const": [
              "HANDOFF"
            ]
          },
          "publicContract": {
            "properties": {
              "available": {
                "const": false
              },
              "protocol": {
                "const": null
              },
              "definitionSha256": {
                "const": null
              }
            }
          },
          "hostAdapter": {
            "properties": {
              "available": {
                "const": false
              },
              "profileSha256": {
                "const": null
              }
            }
          },
          "identityBinding": {
            "properties": {
              "mode": {
                "const": "STATIC_ARTIFACT"
              },
              "certificateSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "artifactSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "contractId": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publicContract": {
            "properties": {
              "available": {
                "const": false
              }
            },
            "required": [
              "available"
            ]
          }
        },
        "required": [
          "publicContract"
        ]
      },
      "then": {
        "properties": {
          "publicContract": {
            "properties": {
              "protocol": {
                "const": null
              },
              "definitionSha256": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "hostAdapter": {
            "properties": {
              "available": {
                "const": false
              }
            },
            "required": [
              "available"
            ]
          }
        },
        "required": [
          "hostAdapter"
        ]
      },
      "then": {
        "properties": {
          "hostAdapter": {
            "properties": {
              "profileSha256": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publicContract": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          }
        },
        "required": [
          "publicContract"
        ]
      },
      "then": {
        "properties": {
          "publicContract": {
            "properties": {
              "protocol": {
                "type": "string",
                "minLength": 1
              },
              "definitionSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "hostAdapter": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          }
        },
        "required": [
          "hostAdapter"
        ]
      },
      "then": {
        "properties": {
          "hostAdapter": {
            "properties": {
              "profileSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identityBinding": {
            "properties": {
              "mode": {
                "const": "STATIC_ARTIFACT"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "identityBinding"
        ]
      },
      "then": {
        "properties": {
          "identityBinding": {
            "properties": {
              "certificateSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "artifactSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "contractId": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identityBinding": {
            "properties": {
              "mode": {
                "const": "RUNTIME_SIGNER_AND_CONTRACT"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "identityBinding"
        ]
      },
      "then": {
        "properties": {
          "identityBinding": {
            "properties": {
              "certificateSha256": {
                "const": null
              },
              "artifactSha256": {
                "const": null
              },
              "contractId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "trustState": {
            "const": "OWNED_RUNTIME_LOCAL_VERIFIED"
          }
        },
        "required": [
          "trustState"
        ]
      },
      "then": {
        "properties": {
          "providerKind": {
            "const": "OWNED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "trustState": {
            "const": "VENDOR_CONTRACT_VERIFIED"
          }
        },
        "required": [
          "trustState"
        ]
      },
      "then": {
        "properties": {
          "providerKind": {
            "const": "VENDOR"
          },
          "publicContract": {
            "properties": {
              "available": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executionEnabled": {
            "const": true
          }
        },
        "required": [
          "executionEnabled"
        ]
      },
      "then": {
        "properties": {
          "hostAdapter": {
            "properties": {
              "available": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jidan.dev/jcl.hand-compiler-v0.1.schema.json",
  "title": "JCL Hand Compiler 0.1",
  "description": "A compiler registration transforms or validates a device-neutral plan. It never grants device execution authority.",
  "type": "object",
  "properties": {
    "profile": { "const": "JCL-Hand-Compiler/0.1" },
    "compilerId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "compilerKind": {
      "enum": ["HAND_IR_TRANSFORMER", "PLAN_VALIDATOR_STUB"]
    },
    "inputProfile": {
      "enum": ["JCL-Hand-IR/0.1-dev", "JCL-Owned-Action-Plan/0.1"]
    },
    "outputProfile": {
      "type": ["string", "null"],
      "maxLength": 120
    },
    "targetPolicy": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["ANY_ANDROID_PACKAGE", "EXACT_PACKAGE"] },
        "package": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "supportedLanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["SANDBOX", "OWNED_APP", "SHADOW"] }
        }
      },
      "required": ["mode", "package", "supportedLanes"],
      "additionalProperties": false
    },
    "supportedOperations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "OPEN_PACKAGE",
          "FIND_CLICK",
          "FIND_SET_TEXT",
          "FIND_SCROLL_FORWARD",
          "GLOBAL_BACK",
          "WAIT_MS",
          "CLICK",
          "SET_TEXT",
          "SCROLL",
          "BACK",
          "WAIT",
          "LAUNCH"
        ]
      }
    },
    "contentPolicy": { "const": "DEVELOPMENT_PASS_THROUGH" },
    "deviceConsumerAvailable": { "const": false },
    "executionAuthority": { "const": "NONE" },
    "notes": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    }
  },
  "required": [
    "profile",
    "compilerId",
    "displayName",
    "compilerKind",
    "inputProfile",
    "outputProfile",
    "targetPolicy",
    "supportedOperations",
    "contentPolicy",
    "deviceConsumerAvailable",
    "executionAuthority",
    "notes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "compilerKind": { "const": "HAND_IR_TRANSFORMER" } },
        "required": ["compilerKind"]
      },
      "then": {
        "properties": {
          "inputProfile": { "const": "JCL-Hand-IR/0.1-dev" },
          "outputProfile": { "type": "string", "minLength": 1 },
          "supportedOperations": {
            "items": {
              "enum": [
                "OPEN_PACKAGE",
                "FIND_CLICK",
                "FIND_SET_TEXT",
                "FIND_SCROLL_FORWARD",
                "GLOBAL_BACK",
                "WAIT_MS"
              ]
            }
          },
          "targetPolicy": {
            "properties": {
              "mode": { "const": "ANY_ANDROID_PACKAGE" },
              "package": { "const": null }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "compilerKind": { "const": "PLAN_VALIDATOR_STUB" } },
        "required": ["compilerKind"]
      },
      "then": {
        "properties": {
          "inputProfile": { "const": "JCL-Owned-Action-Plan/0.1" },
          "outputProfile": { "const": null },
          "supportedOperations": {
            "items": {
              "enum": ["CLICK", "SET_TEXT", "SCROLL", "BACK", "WAIT", "LAUNCH"]
            }
          },
          "targetPolicy": {
            "properties": {
              "mode": { "const": "EXACT_PACKAGE" },
              "package": { "type": "string" },
              "supportedLanes": { "const": ["OWNED_APP"] }
            }
          }
        }
      }
    }
  ]
}
